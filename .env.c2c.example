# ── KDISC Campus-to-Corporate (c2c.kdiscmis.org.in) env template ────────────
# The .cpanel.yml deploy copies this to app/.env on the FIRST deploy only.
# After that, edit the live app/.env on the server and fill in the real values
# below — later deploys never overwrite it. app/.env is gitignored; never
# commit a populated copy.

# ── Application ─────────────────────────────────────────────────────────────
APP_ENV=production
# Generate a long random string, e.g.:  php -r "echo bin2hex(random_bytes(32));"
APP_SECRET=change-this-to-a-long-random-secret

# ── Database ────────────────────────────────────────────────────────────────
# Create the database + user in cPanel → MySQL® Databases, then fill these in.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=shooting_c2c
DB_USERNAME=
DB_PASSWORD=

# ── Mail (SMTP) ─────────────────────────────────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@c2c.kdiscmis.org.in
MAIL_FROM_NAME=KDISC Campus to Corporate

# ── Google OAuth ────────────────────────────────────────────────────────────
# Add this exact redirect URI in the Google Cloud console for the OAuth client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://c2c.kdiscmis.org.in/auth/google/callback

# ── Razorpay (ePayment) ─────────────────────────────────────────────────────
# Use rzp_test_… keys until the account is activated, then switch to rzp_live_…
# KEY_SECRET MUST stay secret — never check it in.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
